# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/expense_tracker
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/expense_tracker_test
REDIS_URL=redis://localhost:6379/0
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
S3_BUCKET=expense-receipts
AWS_REGION=us-east-1
# Only for MinIO/LocalStack (e.g. http://localhost:9000); leave empty for real AWS (IAM role gives credentials)
S3_ENDPOINT_URL=
